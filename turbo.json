{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "static/**"]
    },
    "typecheck": {},
    "test": {},
    "test:integration": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "budget:check": {
      "dependsOn": ["build"]
    }
  }
}
