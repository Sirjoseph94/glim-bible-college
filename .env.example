# Copy to .env for local development: `cp .env.example .env`.
#
# Every variable is read by packages/shared/src/config.ts (TRD §22.3). Locally everything is
# optional: an unset or empty value falls back to the default shown, which points at the Docker
# compose stack (docker/compose.yaml). Uncomment a line only to change it, and set each variable
# once (a later line wins). Variables marked [prod] are required when NODE_ENV=production, and
# [secret] values are never committed (docs/secrets.md).

# ── App ─────────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=development                      # development | test | production
PORT=3000
LOG_LEVEL=info                            # fatal | error | warn | info | debug | trace | silent
# APP_ORIGIN=http://localhost:3000        # [prod] public URL; defaults to http://localhost:$PORT
# INSTITUTION_DEFAULT_TZ=Africa/Lagos     # IANA timezone
# CLIENT_IP_HEADER=                       # header carrying the client IP (on the VPS: x-real-ip, set by Caddy)

# ── Database (Postgres 18) ──────────────────────────────────────────────────────────────────────
# [prod] [secret] in production. glim_app goes through the pool; DIRECT bypasses it (pg-boss, LISTEN).
# DATABASE_URL=postgres://glim_app:glim_app@localhost:5432/glim
# DATABASE_URL_DIRECT=postgres://glim_app:glim_app@localhost:5432/glim
# DATABASE_URL_MIGRATOR=postgres://glim_migrator:glim_migrator@localhost:5432/glim
# Pool sizes; startup fails if API×DB_POOL_API + WORKER×DB_POOL_WORKER + DB_POOL_BOSS + 1 > budget.
# DB_CONNECTION_BUDGET=50
# DB_POOL_API=8
# DB_POOL_WORKER=6
# DB_POOL_BOSS=4
# API_INSTANCE_COUNT=2
# WORKER_INSTANCE_COUNT=1

# ── Worker ──────────────────────────────────────────────────────────────────────────────────────
# WORKER_ROLE=all                         # general | google | media | scheduler | all
# Per-queue concurrency: QUEUE_CONCURRENCY_<queue name, dots and dashes as _, upper case>, e.g.
# QUEUE_CONCURRENCY_RECORDING_INGEST=1

# ── Sessions ────────────────────────────────────────────────────────────────────────────────────
# [prod] [secret] 48+ random characters each (openssl rand -base64 48). Dev defaults are built in.
# SESSION_SECRET=
# CSRF_SECRET=

# ── Google sign-in (staff) ──────────────────────────────────────────────────────────────────────
# GOOGLE_OIDC_ISSUER=https://accounts.google.com
# GOOGLE_OAUTH_CLIENT_ID=                 # [prod]
# GOOGLE_OAUTH_CLIENT_SECRET=             # [prod] [secret]

# ── File storage (S3 API: MinIO locally, Cloudflare R2 in production) ──────────────────────────────
# STORAGE_ENDPOINT=http://localhost:9000  # [prod]
# STORAGE_REGION=us-east-1                # [prod]
# STORAGE_BUCKET=glim-files               # [prod]
# STORAGE_BACKUP_BUCKET=glim-backups
# STORAGE_ACCESS_KEY=minioadmin           # [prod] [secret]
# STORAGE_SECRET_KEY=minioadmin           # [prod] [secret]

# ── Email ───────────────────────────────────────────────────────────────────────────────────────
# MAIL_PROVIDER=smtp                      # smtp (development only; Mailpit UI on :8025) | sendgrid (production default)
# MAIL_FROM=GLIM Bible College <no-reply@glim.local>   # [prod]
# SMTP_URL=smtp://localhost:1025
# SENDGRID_API_KEY=                       # [secret] required when MAIL_PROVIDER=sendgrid
# SENDGRID_WEBHOOK_PUBLIC_KEY=            # verifies SendGrid event webhooks

# ── Backups ─────────────────────────────────────────────────────────────────────────────────────
# BACKUP_AGE_RECIPIENT=age1…              # [prod] the age PUBLIC key; the private key stays offline
# PG_DUMP_PATH=pg_dump                    # absolute path to a Postgres 18 pg_dump, e.g.
#                                         # /opt/homebrew/opt/postgresql@18/bin/pg_dump

# ── Feature switches ────────────────────────────────────────────────────────────────────────────
# FEATURE_DIRECT_UPLOAD=false
# FEATURE_PHONE_DIAL_IN=false             # "Join by phone" on Class Meetings (Google integration)

# ── Google Meet integration (docs/runbooks/google.md) ───────────────────────────────────────────
# Off by default: Lecturers paste Meet links. `fake` uses in-memory stand-ins (development only).
# LIVE_PROVIDER=none                      # none | google_meet | fake
# Required when LIVE_PROVIDER=google_meet:
# GOOGLE_PROJECT_ID=
# GOOGLE_SA_KEY_JSON_B64=                 # [secret] base64 -i glim-meet-key.json
# GOOGLE_PUBSUB_TOPIC=glim-meet-events    # short name with GOOGLE_PROJECT_ID, or projects/<p>/topics/<t>
# GOOGLE_PUBSUB_SUBSCRIPTION=glim-meet-events-pull
# GOOGLE_EVENTS_MODE=pull                 # pull | push

# ── Videos (YouTube) ────────────────────────────────────────────────────────────────────────────
# youtube_link: staff add YouTube links by hand. youtube_api: Meet recordings upload automatically.
# VIDEO_HOST=youtube_link                 # youtube_link | youtube_api | fake
# Required when VIDEO_HOST=youtube_api:
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=            # [secret]
# TOKEN_ENCRYPTION_KEY=                   # [secret] 32 bytes: openssl rand -base64 32
# DRIVE_CLEANUP_MODE=NONE                 # NONE | TRASH_AFTER_INGEST (decision D-07: keep originals)

# ── Tests (local only) ──────────────────────────────────────────────────────────────────────────
# Use servers you already run instead of starting Testcontainers (docs/runbooks/local-dev.md).
# TEST_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/postgres   # needs CREATEDB/CREATEROLE
# TEST_S3_ENDPOINT=http://localhost:9000

# ── Outside the app config ──────────────────────────────────────────────────────────────────────
# GLIM_PG_PORT=5432                       # host port for compose's Postgres, if 5432 is taken
# VITE_DEV_UI=false                       # web build: include the design-system gallery (e2e only)
