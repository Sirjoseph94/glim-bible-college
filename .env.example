# Copy to .env for local development. Every variable is optional locally: unset values default to
# the Docker compose stack (docker/compose.yaml). See TRD §22.3 and packages/shared/src/config.ts.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# The Google integration (docs/runbooks/google.md). Off by default: pasted Meet links, YouTube
# links added by hand. `fake` uses in-memory stand-ins (development only).
# LIVE_PROVIDER=none
# GOOGLE_PROJECT_ID=
# GOOGLE_SA_KEY_JSON_B64=
# GOOGLE_PUBSUB_TOPIC=glim-meet-events
# GOOGLE_PUBSUB_SUBSCRIPTION=glim-meet-events-pull
# VIDEO_HOST=youtube_link
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=
# DRIVE_CLEANUP_MODE=NONE
