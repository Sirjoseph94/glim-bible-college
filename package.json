{
  "name": "glim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise apps packages --config .dependency-cruiser.cjs",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "commitlint": "commitlint",
    "prepare": "simple-git-hooks",
    "budget:check": "turbo run budget:check",
    "db:migrate": "pnpm --filter @glim/db db:migrate",
    "db:generate": "pnpm --filter @glim/db db:generate"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "simple-git-hooks": "2.14.0",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
