{
  "name": "@glim/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig ../../tsconfig.base.json --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "build": "node scripts/copy-static.mjs",
    "admin:bootstrap": "tsx --tsconfig ../../tsconfig.base.json --env-file-if-exists=../../.env src/bin/bootstrap-admin.ts",
    "e2e:serve": "APP_ORIGIN=http://localhost:4173 PORT=4173 CLIENT_IP_HEADER=x-e2e-client-ip tsx --tsconfig ../../tsconfig.base.json --env-file-if-exists=../../.env test/e2e-server.ts",
    "start": "tsx --tsconfig ../../tsconfig.base.json src/main.ts"
  },
  "dependencies": {
    "@fastify/compress": "9.2.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@glim/contracts": "workspace:*",
    "@glim/db": "workspace:*",
    "@glim/integrations": "workspace:*",
    "@glim/modules": "workspace:*",
    "@glim/shared": "workspace:*",
    "@glim/telemetry": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "fastify": "5.12.5",
    "pg-boss": "12.37.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@glim/web": "workspace:*",
    "@nestjs/testing": "12.1.2",
    "@testcontainers/postgresql": "12.2.0"
  }
}
