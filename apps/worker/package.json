    "@glim/modules": "workspace:*",
    "@glim/shared": "workspace:*",
    "@glim/telemetry": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "pg-boss": "12.37.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
